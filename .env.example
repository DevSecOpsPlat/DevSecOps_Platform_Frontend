# Copier vers .env et remplir (ne jamais committer .env)

# Cluster K3s (master VMware)
K8S_API_URL=https://192.168.92.10:6443
K8S_TOKEN=
K8S_INSECURE_SKIP_TLS_VERIFY=true

# Ingress / preview URLs
DEPLOYMENT_INGRESS_DOMAIN=192.168.92.10.nip.io
DEPLOYMENT_PREVIEW_NIP_MASTER_IP=192.168.92.10

# URL backend joignable depuis GitLab CI (tunnel ou IP publique)
BACKEND_PUBLIC_URL=

# Secret partagé backend ↔ pipeline GitLab (identique à PIPELINE_SECRET en CI)
PIPELINE_SECRET=

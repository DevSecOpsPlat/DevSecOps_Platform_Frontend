# Dev image: ng serve + live reload (source mounted as volume)
FROM node:20-alpine
WORKDIR /app

COPY package*.json ./
RUN npm ci

# Source is bind-mounted at runtime; keep node_modules from the image
EXPOSE 4200

# --poll: reliable file watching on Docker Desktop (Windows/macOS bind mounts)
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000", "--disable-host-check"]
